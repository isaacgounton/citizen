[Unit]
Description=Kofi Citizen Agent - Benin Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Desktop/Dev/citizen
EnvironmentFile=/home/ubuntu/Desktop/Dev/citizen/.env
ExecStart=/home/ubuntu/Desktop/Dev/citizen/.venv/bin/nanobot gateway
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
